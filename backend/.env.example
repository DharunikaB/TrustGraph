# Copy this file to .env and adjust as needed for local development.
# Never commit a real .env file.

APP_NAME="AI Payment Abuse Intelligence"
ENVIRONMENT=development
DEBUG=true

# Async SQLAlchemy URL. Use `db` as the host when running via
# docker-compose; use `localhost` when running the API directly on
# your machine against the dockerized Postgres.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payment_abuse_intel
DB_ECHO=false

# Synthetic data generation defaults (all overridable via CLI flags on
# scripts/generate_synthetic_data.py).
SYNTHETIC_RANDOM_SEED=42
SYNTHETIC_NORMAL_CUSTOMERS=600
SYNTHETIC_SHARED_INFRA_CUSTOMERS=250
SYNTHETIC_ABUSE_CUSTOMERS=150
SYNTHETIC_MERCHANT_COUNT=5
SYNTHETIC_DATA_DIR=data/synthetic

# M4: AI Investigator (Gemini). Leave GEMINI_API_KEY unset to use the
# deterministic mock client (no network access, no credentials needed) --
# the full test suite and API run fine without it. Set a real key to
# enable live Gemini calls.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
